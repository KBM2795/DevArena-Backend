ENV=development
SERVER_PORT=8080
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_DBNAME=devarena
DATABASE_SSLMODE=disable
CLERK_PEM_PUBLIC_KEY=...
CLERK_AUTHORIZED_PARTIES=frontend,devarena
CLERK_WEBHOOK_SIGNING_SECRET=...
GITHUB_PAT : ...
GEMINI_API_KEY=...
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20

# Supabase Storage Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role key - used by backend for storage uploads (bypasses RLS)
# Get from: Supabase Dashboard > Project Settings > API > service_role (secret) key
# WARNING: Never expose this to the frontend or commit to git
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET=submissions
